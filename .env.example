# The image docker-compose.yml runs, and its version: a release tag (v0.14.0) or latest (main)
# ROASTWARDEN_IMAGE=ghcr.io/jsprague84/roastwarden
# ROASTWARDEN_VERSION=latest

# HTTP server
ROASTWARDEN_HTTP_ADDR=0.0.0.0:8080

# Owner key for control and all mutating /api calls, at least 16 characters
# (openssl rand -hex 24). Unset: the server makes one at first start, saves it as
# owner.key beside the database and logs it once. ROASTWARDEN_AUTH=off keeps it open instead.
# Devices connecting to /ws/device/{id}/telemetry pass it as ?token=...
# ROASTWARDEN_API_KEY=

# Reads need a credential too (a browser signs in once; scripts send a token). "open" lets
# anyone who reaches the server read: a trusted LAN, or behind a proxy that signs people in.
# ROASTWARDEN_READS=open

# Artisan as a screen (docs/artisan-screen.md): a Modbus TCP slave Artisan reads like a Modbus
# roaster. Off unless set. It serves the one real roaster heard, or the one named; read-only
# unless writes are on (Artisan's Air and Burner sliders, through the roaster's control gate).
# With docker-compose.yml, uncomment its port and ROASTWARDEN_MODBUS_ADDR lines instead.
# ROASTWARDEN_MODBUS_ADDR=0.0.0.0:502
# ROASTWARDEN_MODBUS_DEVICE_ID=esp32_roaster_01
# ROASTWARDEN_MODBUS_WRITES=on

# The built-in MQTT broker (docker-compose.single.yml; docs/DEPLOY.md, "One container"): the
# server runs its own broker on this address, so no mosquitto is needed. The roasters in
# MQTT_DEVICES sign in to it; MQTT_PASSWORD is optional then (the server's own, made at start).
# Leave it unset to use the broker below; with docker-compose.single.yml, whose default turns
# it on, write off (docs/install-docker.md, "With your own MQTT broker").
# ROASTWARDEN_BROKER_ADDR=0.0.0.0:1883

# MQTT broker: the compose file's own (mosquitto), or your broker's address
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# MQTT_CLIENT_ID=roastwarden-myhost-1234
# The broker takes no anonymous clients (docker/mosquitto). The server signs in as
# "roastwarden" with MQTT_PASSWORD (required by docker-compose.yml: openssl rand -hex 16); each
# roaster as its device id, listed here as id:password pairs, and may use only roaster/<id>/#.
# MQTT_USERNAME=roastwarden
MQTT_PASSWORD=
# MQTT_DEVICES=my_roaster:another-long-password
# Home Assistant discovery (docs/home-assistant.md): Home Assistant signs in to the broker as
# "homeassistant" with this password and reads the roasters' discovery and state, nothing else
# MQTT_HOME_ASSISTANT_PASSWORD=
MQTT_KEEP_ALIVE_SECS=30
# TLS to the broker (port is usually 8883). MQTT_CA_CERT is the broker CA in PEM,
# or a system bundle such as /etc/ssl/certs/ca-certificates.crt for public CAs.
# MQTT_TLS=true
# MQTT_CA_CERT=/etc/ssl/certs/ca-certificates.crt

# Database (SQLite)
# ROASTWARDEN_DB_PATH=./data/roastwarden.db
# ROASTWARDEN_BACKUP_DIR=./data/backups   # nightly database copies (docs/DEPLOY.md "Backups")
